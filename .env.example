# --- Database ---
# Runtime: Supabase transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations/admin: session pooler (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Storage ---
STORAGE_BACKEND=local
VAULT_DATA_DIR=.vault-data
# BLOB_READ_WRITE_TOKEN=            # only needed when STORAGE_BACKEND=blob

# --- Cluster / durability policy ---
VAULT_CLUSTER=main
VAULT_N=3
VAULT_W=2
VAULT_R=2
VAULT_MIN_HEALTHY_REPLICAS=2
VAULT_ALLOW_TEMP_OVERREPLICATION=on

# Optional explicit failure-domain mapping. If omitted, node-1..3 => rack-a and node-4..6 => rack-b.
# VAULT_FAILURE_DOMAINS='{"node-1":"rack-a","node-2":"rack-a","node-3":"rack-a","node-4":"rack-b","node-5":"rack-b","node-6":"rack-b"}'

# --- Background maintenance ---
VAULT_AUTOPILOT=off
VAULT_HEARTBEAT_INTERVAL_MS=5000
VAULT_HEARTBEAT_TIMEOUT_MS=15000
VAULT_REPAIR_INTERVAL_MS=15000
VAULT_SCRUB_INTERVAL_MS=60000
VAULT_SCRUB_BATCH_SIZE=40

# --- Object limits ---
VAULT_CHUNK_SIZE_BYTES=4194304
VAULT_MAX_OBJECT_BYTES=26214400